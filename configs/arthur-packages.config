#
# 亚瑟（JDCloud RE-SS-01）功能包种子配置
#
# 需求：无 WiFi（见 arthur-device.config） / 带 USB / NSS 硬件加速 /
#       预装 ShadowSocksR Plus / 预置 Open-Box（透明代理）运行环境
#
# 每一项都对着 immortalwrt@openwrt-25.12 + nss_packages 的包名核对过；
# 不确定是否存在的包不要写进来（写错的符号会被 defconfig 丢掉，但会误导人）。
#

# ---------- 基础 ----------
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_zh_Hant=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# ---------- 界面 ----------
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_openssh-sftp-server=y

# ---------- 常用工具 ----------
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_tune2fs=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-3cat=y
CONFIG_PACKAGE_luci-app-wol=y

# 小内存设备常备：zram swap（512MB 机器跑代理面板会吃紧）
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

# ---------- USB 3.0 + 外置存储 ----------
# 亚瑟的 USB3.0 口在设备树里是 &usb3 / &qusb_phy_0 = okay，驱动必须成套进来
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_smartmontools=y

# ---------- NSS 硬件加速（转发/加密/隧道卸载到 NSS 核）----------
# 依据：上游 JDCloud 无WiFi 成品 manifest 里的实际包名
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-ssdk=y
CONFIG_PACKAGE_kmod-nss-ifb=y
CONFIG_PACKAGE_nss-firmware-ipq60xx=y
# EIP 加解密引擎固件（crypto offload 配套；上游成品 manifest 里也有）
CONFIG_PACKAGE_nss-eip-firmware=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pptp=y
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tun6rd=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6=y
CONFIG_PACKAGE_kmod-qca-nss-drv-match=y
CONFIG_PACKAGE_kmod-qca-nss-drv-mirror=y
CONFIG_PACKAGE_kmod-qca-nss-drv-lag-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-gre=y
CONFIG_PACKAGE_kmod-qca-nss-drv-eogremgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vxlanmgr=y

# ---------- 预装：ShadowSocksR Plus（luci-app-ssr-plus）----------
# 源码不在 feeds 里，由 scripts/diy-arthur.sh 从 kenzok8/small-package 稀疏克隆进来
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-ssr-plus=y

# 透明代理后端：25.12 是 fw4/nftables
CONFIG_PACKAGE_luci-app-ssr-plus_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-ssr-plus_Iptables_Transparent_Proxy is not set

# 客户端内核（不选就没有可用的节点协议）
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y

# 分流与规则数据（离线可用，不用开机再去下）
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_GeoData=y
CONFIG_PACKAGE_v2ray-geodata=y

# 明确的取舍
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Mihomo=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadow_TLS=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n

# 上面的 INCLUDE_* 会通过依赖自动带出这些协议内核包；这里再显式写一遍：
# 一是保证一定进镜像（第 13 步 manifest 会逐个校验），二是万一包名对不上，
# defconfig 阶段就会留下 warning 被第 8 步抓到，而不是编完了才发现少东西。
# 注意：nping 由 feeds 里的 net/nmap 提供（不是独立目录），resolveip 来自 base-files。
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_microsocks=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_dns2tcp=y
CONFIG_PACKAGE_lua-neturl=y
CONFIG_PACKAGE_lyaml=y
CONFIG_PACKAGE_nping=y
CONFIG_PACKAGE_resolveip=y

# DNS：ssr-plus 依赖 dnsmasq-full
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# 保持单一代理栈：不预装 PassWall / OpenClash，避免和 ssr-plus、Open-Box 抢 DNS 与透明代理规则
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-openclash=n

# ---------- 预置：Open-Box（一体化透明代理）运行环境 ----------
# Open-Box 本体是闭源发布包，由官方 install.sh 按架构下载（aarch64 / musl ≥1.2.4，本固件满足）。
# 这里把 install.sh 会检查的系统依赖全部预装，首启就能装成功，不用再连软件源。
#   详见 overlay-arthur/usr/share/open-box/README.txt
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_iptables-nft=y
