#
# Orange Pi Zero 2 (Xunlong, Allwinner H616) —— OpenWrt 24.10 配置种子
#
# 用法：cp 成 openwrt/.config 后 make defconfig
# 注意：这里只写"需要显式指定"的项，其余交给 defconfig 推导。
#       每一项的符号名都对着 openwrt-24.10 源码和官方发行包索引核对过。
#

# ---------- 目标与设备 ----------
CONFIG_TARGET_sunxi=y
CONFIG_TARGET_sunxi_cortexa53=y
CONFIG_TARGET_sunxi_cortexa53_DEVICE_xunlong_orangepi-zero2=y

# ---------- 镜像形态 ----------
# 两个都开 = 上游 sunxi 的默认（FEATURES 里同时有 ext4 和 squashfs），
# 也确实会产出两个镜像文件（已对照官方 24.10.8 下载目录确认）：
#   ...-xunlong_orangepi-zero2-ext4-sdcard.img.gz      ← 跑 Docker 用这个
#   ...-xunlong_orangepi-zero2-squashfs-sdcard.img.gz
# 这里刻意与官方默认保持一致，不引入未知变量。
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_SUNXI_SD_BOOT_PARTSIZE=32
# 关键：sunxi 的 sdcard 镜像是编译期定死大小的（gen_sunxi_sdcard_img.sh 吃这个值），
# 刷完不会自动扩容。Config-images.in:306 的默认值是 104（MiB），
# docker pull 第一个镜像就可能爆盘，这里给到 2048。
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# ---------- 板载无线 AW859A / UWE5622 ----------
CONFIG_PACKAGE_kmod-uwe5622=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y

# ---------- 板载蓝牙 ----------
CONFIG_PACKAGE_kmod-bluetooth=y
CONFIG_PACKAGE_bluez-daemon=y
CONFIG_PACKAGE_bluez-utils=y
CONFIG_PACKAGE_bluez-libs=y

# ---------- Docker ----------
# 注意：dockerd 只是守护进程，CLI 在独立的 docker 包里，不点它就没有 docker 命令
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-lib-docker=y
# dockerd 自己会拉 containerd/runc/tini/iptables/kmod-veth 等，这里只额外补网络相关的
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-nf-ipvs=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-nat=y

# ---------- 存储 / 分区操作 ----------
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_partx-utils=y
CONFIG_PACKAGE_e2fsprogs=y

# ---------- LuCI ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y

# ---------- 路由基础 ----------
# 官方镜像默认不带这些（sunxi 目标没设 DEVICE_TYPE=router），要自己点
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y

# ---------- 编译优化 ----------
CONFIG_CCACHE=y

# ============================================================
# Docker 需要的内核能力
#
# 这几项不是可有可无：openwrt-24.10 的 target/linux/generic/config-6.6 里
#   # CONFIG_CGROUPS is not set      (第 849 行)
#   # CONFIG_NAMESPACES is not set   (第 3835 行)
#   # CONFIG_POSIX_MQUEUE is not set (第 4681 行)
#   # CONFIG_SECCOMP is not set      (第 5310 行)
# 全是关的，不开 dockerd 根本起不来。
# 生效机制：include/kernel-defaults.mk 第 117 行会把 .config 里所有 CONFIG_KERNEL_*
# 去掉 "KERNEL_" 前缀后**追加**到内核 .config.target 末尾，因此能覆盖上面的基线。
#
# 顺带说明：CONFIG_OVERLAY_FS 在基线里本来就是 y（第 4395 行），
# Docker 的 overlay2 存储驱动不用额外处理。
# ============================================================
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_CGROUP_PIDS=y
CONFIG_KERNEL_CGROUP_CPUACCT=y
CONFIG_KERNEL_CPUSETS=y
CONFIG_KERNEL_MEMCG=y
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_NET_NS=y
CONFIG_KERNEL_PID_NS=y
CONFIG_KERNEL_IPC_NS=y
CONFIG_KERNEL_UTS_NS=y
CONFIG_KERNEL_USER_NS=y
CONFIG_KERNEL_POSIX_MQUEUE=y
CONFIG_KERNEL_SECCOMP=y
CONFIG_KERNEL_SECCOMP_FILTER=y
# 注意：这里**没有** CONFIG_KERNEL_VETH。veth 在 OpenWrt 里不是一个 KERNEL_ 符号，
# 而是由 kmod-veth 这个内核模块包用 KCONFIG:=CONFIG_VETH 驱动的（见上面
# CONFIG_PACKAGE_kmod-veth=y）。写了 CONFIG_KERNEL_VETH 会被 make defconfig 静默丢弃。
#
# 上述符号名已逐个对照 config/Config-kernel.in 核实存在（注意该文件里
# cgroup / namespace 的子项是带 Tab 缩进写在 if 块内的，用 ^config 搜会全部漏掉）。
