#
# JDCloud RE-SS-01（京东云无线宝 亚瑟 AX1800 Pro）
# SoC: IPQ6000(4×A53 1.2G + NPU) / RAM: 512MB / eMMC: 64GB / 网口: 1WAN+3LAN 千兆 / USB3.0 ×1
#
# 设备种子配置：无 WiFi + 6.18 内核 + NSS 12.5 硬件加速
# 与 configs/arthur-packages.config 一起拼成 .config（本文件在前，后者覆盖前者）
#
# 注意：这里的符号名对着 laipeng668/immortalwrt@openwrt-25.12 源码核对过，
#       并对照上游 JDCloud 无WiFi 成品的 manifest 验证过（NSS 驱动确实进镜像）。
#

# ---------- 目标与机型 ----------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

# 清空本机型的默认附加包：去掉 ipq-wifi-jdcloud_re-ss-01（无线校准数据，无WiFi 的机器用不上）。
# 别人验证过的写法就是这个空串，别改成别的。
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=""

# ---------- 内核与 NSS ----------
# NSS 驱动/固件来自 laipeng668/nss-packages（feeds 里叫 nss_packages，分支 NSS-12.5-K6.x），
# 必须配 6.x 内核，所以打开测试内核开关拿 6.18。
CONFIG_TESTING_KERNEL=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_KERNEL_SKB_RECYCLER=y
CONFIG_KERNEL_SKB_RECYCLER_MULTI_CPU=y

# NSS 驱动内存档位：亚瑟 512MB，取 MEDIUM（上游 Arthur 成品就是这个档位）
CONFIG_NSS_MEM_PROFILE_MEDIUM=y

# NSS 驱动的功能开关，照抄上游已验证的 Arthur/Athena/Taiyi 成品。
# 无 WiFi 机型不启用 WIFIOFFLOAD / WIFI_EXT_VDEV 两项（没有 ath11k 就不需要）。
CONFIG_NSS_DRV_BRIDGE_ENABLE=y
CONFIG_NSS_DRV_CRYPTO_ENABLE=y
CONFIG_NSS_DRV_GRE_ENABLE=y
CONFIG_NSS_DRV_GRE_REDIR_ENABLE=y
CONFIG_NSS_DRV_IGS_ENABLE=y
CONFIG_NSS_DRV_IPV6_ENABLE=y
CONFIG_NSS_DRV_L2TP_ENABLE=y
CONFIG_NSS_DRV_LAG_ENABLE=y
CONFIG_NSS_DRV_MAPT_ENABLE=y
CONFIG_NSS_DRV_MATCH_ENABLE=y
CONFIG_NSS_DRV_MIRROR_ENABLE=y
CONFIG_NSS_DRV_PPPOE_ENABLE=y
CONFIG_NSS_DRV_PPTP_ENABLE=y
CONFIG_NSS_DRV_SHAPER_ENABLE=y
CONFIG_NSS_DRV_TUN6RD_ENABLE=y
CONFIG_NSS_DRV_TUNIPIP6_ENABLE=y
CONFIG_NSS_DRV_VIRT_IF_ENABLE=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_NSS_DRV_VXLAN_ENABLE=y
CONFIG_NSS_NLGRE_REDIR_ENABLE=y

# ---------- 无 WiFi：ath11k 驱动与固件全部关掉 ----------
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ipq-wifi-jdcloud_re-ss-01=n
CONFIG_ATH11K_MEM_PROFILE_512M=n
